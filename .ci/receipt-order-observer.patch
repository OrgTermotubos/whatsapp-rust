+
+async fn wait_for_received_texts(
+    client: &mut TestClient,
+    prefix: &str,
+    count: usize,
+) -> anyhow::Result<()> {
+    let mut pending: HashSet<_> = (0..count).map(|i| format!("{prefix} #{i}")).collect();
+    let result = client
+        .wait_for_event(10, |event| {
+            let observed: Vec<_> = event.messages().filter_map(|m| m.message.conversation.clone()).collect();
+            if !observed.is_empty() { eprintln!("RECEIPT_COLLECTOR prefix={prefix} pending={pending:?} received={observed:?}"); }
+            for message in event.messages() {
+                if !message.info.source.is_from_me
+                    && let Some(text) = message.message.conversation.as_deref()
+                {
+                    pending.remove(text);
+                }
+            }
+            pending.is_empty()
+        })
+        .await;
+    result.with_context(|| format!("Missing decrypted {prefix} messages: {pending:?}"))?;
+    Ok(())
+}
